# Per-stage deploy config template.
#
# Copy to deploy.<stage>.env (e.g. deploy.prod.env), fill in the real values,
# and keep it OUT of git (deploy.*.env is gitignored). `make deploy STAGE=<stage>`
# auto-sources deploy.<stage>.env, so a full-state deploy always carries the
# custom domain instead of silently dropping it. Command-line vars still win.
#
# All values are optional: leave a line blank/absent to use the template default
# (e.g. no custom domain -> the API keeps its execute-api URL and icons serve on
# the CloudFront default *.cloudfront.net domain).

# Route 53 hosted zone ID for the parent domain (shared infra; ADR-0013).
# Required whenever any *_DOMAIN_NAME below is set.
HOSTED_ZONE_ID=

# Custom API hostname (ADR-0013), e.g. api.example.com / api.dev.example.com.
API_DOMAIN_NAME=

# Custom icons-CDN hostname (ADR-0023), e.g. icons.example.com.
# Empty -> icons serve on the CloudFront default domain.
ICON_DOMAIN_NAME=

# Publish the public read-only demo API key ("try the API" links). Default false.
ENABLE_DEMO_KEY=false
